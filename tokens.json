{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Kolang Design System",
  "version": "1.0.0",
  "description": "European Technical Editorial design tokens for Kolang Agent Control Plane / MCP Gateway.",
  "color": {
    "primitive": {
      "jade": {
        "100": "#DCEFE9",
        "300": "#9BD6C4",
        "500": "#26977F",
        "600": "#1D806D",
        "700": "#176B5B",
        "800": "#125647",
        "900": "#0D4136"
      },
      "ink": {
        "950": "#151C1B",
        "900": "#1C2523",
        "800": "#2B3633",
        "700": "#394641"
      },
      "stone": {
        "50": "#F7F8F6",
        "100": "#EEF1EE",
        "200": "#E2E7E3",
        "300": "#D5DDD7",
        "400": "#AAB4AD",
        "500": "#76817B",
        "600": "#56615B",
        "700": "#46514B",
        "800": "#2D3832",
        "900": "#17201D"
      },
      "status": {
        "success": { "fg": "#176B4B", "bg": "#E7F4EC", "fgDark": "#78D5A2", "bgDark": "#1D382B" },
        "warning": { "fg": "#8A5A12", "bg": "#FBF1DD", "fgDark": "#F0C36D", "bgDark": "#3B3020" },
        "danger": { "fg": "#B33B36", "bg": "#FBEAE8", "fgDark": "#FF938B", "bgDark": "#402624" },
        "info": { "fg": "#315F91", "bg": "#E9F1FA", "fgDark": "#91BCEB", "bgDark": "#20354A" },
        "neutral": { "fg": "#59645E", "bg": "#EEF1EE", "fgDark": "#B1BCB5", "bgDark": "#2B3731" }
      }
    },
    "semantic": {
      "light": {
        "canvas": "#F7F8F6",
        "surface": "#FFFFFF",
        "surfaceRaised": "#FFFFFF",
        "surfaceMuted": "#F0F3F0",
        "surfaceSelected": "#E6F2ED",
        "textPrimary": "#17201D",
        "textSecondary": "#56615B",
        "textMuted": "#7B867F",
        "textInverse": "#FFFFFF",
        "borderSubtle": "#E7EBE7",
        "borderDefault": "#E2E7E3",
        "borderStrong": "#D5DDD7",
        "accent": "#176B5B",
        "accentHover": "#125647",
        "accentSubtle": "#E6F2ED",
        "focusRing": "#6CBBA4",
        "overlay": "rgba(17, 24, 22, 0.42)"
      },
      "dark": {
        "canvas": "#111816",
        "surface": "#18211F",
        "surfaceRaised": "#202B28",
        "surfaceMuted": "#202A27",
        "surfaceSelected": "#203C33",
        "textPrimary": "#EEF3EF",
        "textSecondary": "#AAB5AE",
        "textMuted": "#7F8D85",
        "textInverse": "#111816",
        "borderSubtle": "#293631",
        "borderDefault": "#34413B",
        "borderStrong": "#3A4841",
        "accent": "#63C5A8",
        "accentHover": "#82D7BD",
        "accentSubtle": "#203C33",
        "focusRing": "#63C5A8",
        "overlay": "rgba(0, 0, 0, 0.62)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, Geist Sans, Vazirmatn, Arial, sans-serif",
      "persian": "Vazirmatn, Inter, Arial, sans-serif",
      "mono": "Geist Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "scale": {
      "display": { "fontSize": "36px", "lineHeight": "44px", "fontWeight": 600 },
      "h1": { "fontSize": "28px", "lineHeight": "36px", "fontWeight": 600 },
      "h2": { "fontSize": "22px", "lineHeight": "30px", "fontWeight": 600 },
      "h3": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 },
      "titleSm": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 600 },
      "body": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400 },
      "bodySm": { "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400 },
      "label": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 550 },
      "caption": { "fontSize": "11px", "lineHeight": "16px", "fontWeight": 450 },
      "metric": { "fontSize": "30px", "lineHeight": "36px", "fontWeight": 600 },
      "code": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": 450 }
    },
    "numericVariant": "tabular-nums"
  },
  "spacing": {
    "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px",
    "16": "64px", "20": "80px"
  },
  "radius": {
    "xs": "4px", "sm": "6px", "md": "9px", "lg": "12px", "xl": "16px", "full": "999px"
  },
  "borderWidth": { "hairline": "1px", "focus": "2px" },
  "elevation": {
    "none": "none",
    "popover": "0 8px 24px rgba(17, 24, 22, 0.08)",
    "dialog": "0 18px 48px rgba(17, 24, 22, 0.16)"
  },
  "motion": {
    "instant": "100ms",
    "fast": "140ms",
    "normal": "180ms",
    "panel": "220ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "sidebarExpanded": "248px",
    "sidebarCollapsed": "68px",
    "topbarHeight": "60px",
    "pagePaddingDesktop": "28px",
    "pagePaddingTablet": "20px",
    "pagePaddingMobile": "16px",
    "gridColumns": 12,
    "gridGutter": "20px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" }
  },
  "components": {
    "button": { "heightSm": "32px", "heightMd": "36px", "heightLg": "40px", "radius": "6px", "paddingInline": "12px" },
    "input": { "heightMd": "36px", "heightLg": "40px", "radius": "6px", "paddingInline": "12px" },
    "table": { "headerHeight": "40px", "rowHeight": "48px", "rowHeightDense": "40px" },
    "panel": { "padding": "20px", "paddingDense": "16px", "radius": "9px" },
    "dialog": { "radius": "12px" }
  }
}
