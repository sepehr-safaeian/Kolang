# ═══════════════════════════════════════════════════════════════════════════════
# Kolang — Agent Control Plane / MCP Gateway
# Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=kolang
APP_ENV=development                       # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=debug                       # debug | info | warning | error
APP_SECRET_KEY=change-me-in-production    # Used for internal signing; generate a strong random value

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kolang:kolang@localhost:5432/kolang
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Identity / OIDC ─────────────────────────────────────────────────────────
OIDC_ISSUER_URL=http://localhost:8080/realms/kolang
OIDC_CLIENT_ID=kolang-api
OIDC_AUDIENCE=kolang

# ─── OPA Policy Engine ───────────────────────────────────────────────────────
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=v1/data/kolang/authz

# ─── Redis (optional — enable when Rate Limit / Cache / Queue is needed) ─────
REDIS_URL=redis://localhost:6379/0

# ─── Telemetry (OpenTelemetry) ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kolang
OTEL_TRACES_SAMPLER=parentbased_traceidalgorithm
OTEL_METRICS_EXPORT_INTERVAL=30000

# ─── Credential Encryption ───────────────────────────────────────────────────
# Generate with: python scripts/generate_key.py
CREDENTIAL_ENCRYPTION_KEY=generate-with-scripts/generate-key.py

# ─── Rate Limiting (optional) ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_RPM=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
