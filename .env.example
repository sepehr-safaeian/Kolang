# ═══════════════════════════════════════════════════════════════════════════════
# Kolang — Agent Control Plane / MCP Gateway
# Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit .env to version control or include real secret values here.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Runtime Environment & Service ───────────────────────────────────────────
# Canonical: ACP_ENV (Aliases: APP_ENV, ENV)
ACP_ENV=development                       # development | staging | production | test
ACP_APP_NAME=kolang
ACP_DEBUG=true
ACP_SECRET_KEY=change-me-in-production    # Internal secret key; in production MUST be set to a strong random secret

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# In production, local default / localhost URLs are rejected.
ACP_DATABASE_URL=postgresql+asyncpg://kolang:kolang@localhost:5432/kolang
ACP_DATABASE_POOL_SIZE=10
ACP_DATABASE_MAX_OVERFLOW=20

# ─── Identity & OIDC Authentication ──────────────────────────────────────────
# Required in production: ACP_OIDC_ISSUER_URL and ACP_OIDC_AUDIENCE
ACP_OIDC_ISSUER_URL=http://localhost:8080/realms/kolang
ACP_OIDC_AUDIENCE=kolang
ACP_OIDC_CLIENT_ID=kolang-api
# Optional direct JWKS URL if discovery is bypassed or endpoint is static:
ACP_OIDC_JWKS_URL=

# ─── Open Policy Agent (OPA) ──────────────────────────────────────────────────
ACP_OPA_URL=http://localhost:8181
ACP_OPA_POLICY_PATH=v1/data/kolang/authz

# ─── Credential Encryption & Secrets ─────────────────────────────────────────
# In production, a valid 256-bit encryption key is mandatory.
# Set ACP_ENCRYPTION_KEY directly or specify a secret file path via ACP_ENCRYPTION_KEY_PATH.
# Generate with: python scripts/generate_key.py
ACP_ENCRYPTION_KEY=replace-with-base64-256bit-key-from-scripts-generate-key
# ACP_ENCRYPTION_KEY_PATH=/run/secrets/acp_encryption_key

# ─── Logging & Operational Gateway Controls ──────────────────────────────────
ACP_LOG_LEVEL=info                         # debug | info | warning | error | critical
ACP_REQUEST_TIMEOUT_SECONDS=30.0           # Gateway request timeout in seconds (positive float)
ACP_MAX_REQUEST_BODY_BYTES=10485760        # Max request body size in bytes (e.g. 10485760 = 10MB)
# Comma-separated or JSON array of allowed upstream server hosts
ACP_ALLOWED_UPSTREAM_HOSTS=localhost,127.0.0.1

# ─── Cache & Distributed State (Optional) ────────────────────────────────────
ACP_REDIS_URL=redis://localhost:6379/0

# ─── Telemetry (OpenTelemetry) ────────────────────────────────────────────────
ACP_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
ACP_OTEL_SERVICE_NAME=kolang

# ─── Rate Limiting (Optional) ────────────────────────────────────────────────
ACP_RATE_LIMIT_ENABLED=false
ACP_RATE_LIMIT_DEFAULT_RPM=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated or JSON list of origins
ACP_CORS_ORIGINS=["http://localhost:3000"]
